# Hosting estático (Apache) para el build "DEPLOY_TARGET=static": la app es
# un SPA prerenderizado, cada ruta ya tiene su propio index.html generado en
# build time, así que no hace falta ninguna regla de reescritura.

# Fuerza HTTPS. Descomenta si tu hosting ya te da un certificado (en Hostalia,
# activa antes el SSL gratuito del panel).
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

<IfModule mod_headers.c>
  # CSP: sin nonce por petición porque el HTML es estático (lo genera el
  # build, no un servidor), así que a diferencia del despliegue en Node no
  # se puede bloquear el script inline sin "unsafe-inline". El resto de
  # cabeceras da la misma protección que en el despliegue con servidor.
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'self' https://lovable.dev https://*.lovable.dev https://gptengineer.app https://*.gptengineer.app; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://*.supabase.co https://*.lovable.cloud wss://*.supabase.co wss://*.lovable.cloud"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=()"
  Header always set Strict-Transport-Security "max-age=15552000; includeSubDomains"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Los ficheros de /assets/ llevan hash en el nombre: pueden cachearse "para siempre".
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
