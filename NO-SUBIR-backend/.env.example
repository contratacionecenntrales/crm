# Copia este archivo como .env y cambia TODOS los valores antes de arrancar.
NODE_ENV=production
PORT=4000

# Secretos: minimo 32 caracteres. Genera cada uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=cambiame_por_un_secreto_largo_y_aleatorio_de_48_bytes
JWT_REFRESH_SECRET=otro_secreto_distinto_igual_de_largo_y_aleatorio

# Dominio del panel. Es el unico origen que puede llamar a esta API.
FRONTEND_ORIGIN=https://app.labs24k.com

# Cookies: en produccion siempre secure=true (requiere HTTPS)
COOKIE_DOMAIN=labs24k.com

# Google OAuth: ID de cliente de tu proyecto en Google Cloud Console.
# El backend comprueba que el id_token venga emitido para ESTE cliente.
GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Cloudflare Turnstile: clave secreta del sitio (no la "site key" pública).
# Sin esto, login y recuperación no piden verificación anti-bot (ver el aviso
# que imprime el servidor en el arranque si falta).
TURNSTILE_SECRET_KEY=

# Solo para desarrollo local SIN HTTPS: permite arrancar sin NODE_ENV=production
# (las cookies de sesión pierden el flag Secure). Nunca poner esto en producción.
PERMITIR_ARRANQUE_NO_PRODUCCION=false
