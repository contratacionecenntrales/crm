# =============================================================================
# EVOLVIX GLOBAL - Facturacion de Grupo - Configuracion de seguridad Hostalia
# Fuerza HTTPS, cabeceras estrictas y bloqueo de ficheros sensibles.
# Si esta version diera error 500, renombra este archivo a htaccess.txt:
# la aplicacion funciona igual sin el (pero sin estas protecciones) mientras
# se investiga que directiva no admite tu plan de alojamiento.
# NOTA: se han eliminado a proposito RequestReadTimeout, Options y
# ServerSignature porque muchos alojamientos compartidos los prohiben en
# .htaccess y devuelven error 500.
#
# IMPORTANTE - connect-src: todavia no existe un proyecto Supabase real para
# este CRM (la URL en index.html esta vacia), asi que aqui se permite
# cualquier subdominio *.supabase.co. EN CUANTO TENGAS LA URL REAL de tu
# proyecto (algo como https://xxxxxxxx.supabase.co), cambia la linea
# "connect-src" de abajo para poner esa URL exacta en vez del comodin,
# igual que hace el CRM de Labs24k. Es la misma disciplina de seguridad
# aplicada alli: cuanto mas concreto el permiso, menor la superficie de
# ataque.
# =============================================================================

DirectoryIndex index.html

# --- Forzar HTTPS ------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP:X-Forwarded-SSL} !on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# --- Cabeceras de seguridad ---------------------------------------------------
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'none'; script-src 'self' 'sha256-is0XJNfVAgTFkAaLfChjpFA4TL8d2wikN4V3lzCCDCQ='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://*.supabase.co; form-action 'none'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=()"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header unset X-Powered-By
  Header set Cache-Control "no-store"
</IfModule>

# --- Bloqueo de ficheros sensibles (sintaxis doble 2.2 / 2.4) ----------------
<FilesMatch "(^\.|\.(md|zip|log|bak|sql|env|ini|yml|py|sh)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# --- Compresion ---------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript
</IfModule>
