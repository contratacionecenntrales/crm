# Copia este archivo a .env.local y rellena los valores.
# Supabase → Project Settings → API keys

# URL del proyecto y clave PUBLICABLE (puede ir al navegador: RLS la limita)
NEXT_PUBLIC_SUPABASE_URL=https://ezwhkpfqnzyfulivlows.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Clave SECRETA: solo en el servidor (Vercel → Environment Variables).
# Se usa para invitar usuarios por correo y para el webhook de Stripe.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Dirección pública de la plataforma (enlaces de invitación y recuperación)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe → Developers → Webhooks → Signing secret (opcional)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx
